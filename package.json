{
  "name": "claude-os",
  "version": "0.1.0",
  "private": true,
  "description": "A local workspace for Claude Code: projects, sessions, memory and tools on one screen.",
  "license": "Apache-2.0",
  "repository": "github:DezareD/claude-os",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "e2e": "node --import ./e2e/env.ts --disable-warning=ExperimentalWarning --test --test-concurrency=2 \"e2e/**/*.test.ts\"",
    "demo:media": "node --import ./e2e/env.ts --disable-warning=ExperimentalWarning e2e/demo/capture.ts",
    "e2e:serial": "node --import ./e2e/env.ts --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"e2e/**/*.test.ts\"",
    "check:shippable": "node --disable-warning=ExperimentalWarning scripts/check-shippable.ts",
    "check:touchpoints": "node --disable-warning=ExperimentalWarning scripts/check-touchpoints.ts",
    "lint": "oxlint --max-warnings 0",
    "check:lint-ratchet": "node --disable-warning=ExperimentalWarning scripts/check-lint-ratchet.ts",
    "gate": "node --disable-warning=ExperimentalWarning scripts/gate.ts",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "@anthropic-ai/sdk": "^1.4.0",
    "@fastify/static": "^10.1.10",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@huggingface/transformers": "4.3.2",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@xterm/headless": "^6.0.0",
    "chokidar": "^6.0.0",
    "dompurify": "^3.4.17",
    "fastify": "^5.12.8",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.68.0",
    "marked": "^18.1.3",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.36.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "ws": "^8.22.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron/get": "^5.1.0",
    "oxlint": "^1.93.0",
    "rcedit": "^5.0.2"
  }
}
