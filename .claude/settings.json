{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm test*)",
      "Bash(npm run lint*)",
      "Bash(npm run gate)",
      "Bash(npm run check:*)",
      "Bash(npm run build)",
      "Bash(node --disable-warning=ExperimentalWarning --test *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(rg *)"
    ],
    "deny": [
      "Edit(./data/**)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.githooks/**)"
    ],
    "ask": ["Bash(git push*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.mjs\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.mjs\"", "timeout": 30 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.mjs\"", "timeout": 300 }]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/briefing.mjs\"" }]
      }
    ]
  }
}
